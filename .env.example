# Local development on macOS (copy to .env)
VCENTEREMU_HOST=127.0.0.1
VCENTEREMU_PORT=8181
VCENTEREMU_WORKERS=1
VCENTEREMU_UPLOAD_DIR=./uploads
VCENTEREMU_AUTO_LOAD_XLSX=./customer.xlsx
VCENTEREMU_API_USERNAME=admin
VCENTEREMU_API_PASSWORD=changeme
VCENTEREMU_VCENTER_NAME=localhost
VCENTEREMU_MAX_UPLOAD_MB=512
VCENTEREMU_MAX_STORED_UPLOADS=10
VCENTEREMU_MAX_XLSX_UNCOMPRESSED_MB=1024
VCENTEREMU_MAX_XLSX_ROWS=1000000
VCENTEREMU_MAX_XLSX_CELLS=10000000
# Optional comma-separated browser origins. Empty disables CORS.
VCENTEREMU_CORS_ORIGINS=
